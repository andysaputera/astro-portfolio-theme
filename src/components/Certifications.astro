---
import certificationsData from '../data/certifications.json';

// Field yang dipakai dari JSON (lihat contoh di certifications.sample.json):
// name, status, tags[], problem, contribution, outcome
type WorkItem = {
  name: string;
  status?: string;
  tags?: string[];
  problem?: string;
  contribution?: string;
  outcome?: string;
};

const works = certificationsData as WorkItem[];

const pad = (n: number) => String(n + 1).padStart(2, '0');

// Bagian teks Problem / Contribution / Outcome (dirender sama di kartu featured & biasa)
const sections = (w: WorkItem) =>
  [
    { label: 'Problem', text: w.problem },
    { label: 'Contribution', text: w.contribution },
    { label: 'Outcome', text: w.outcome },
  ].filter((s) => s.text);
---

<section id="certifications" class="py-24" style="scroll-margin-top: 80px;">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 reveal">
      <p class="text-sm font-semibold tracking-widest text-highlight uppercase mb-3">MY WORK</p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title">Featured Work</h2>
    </div>

    <div class="work-grid max-w-6xl mx-auto">
      {
        works.map((w, i) => {
          const isFeatured = i === 0;
          return isFeatured ? (
            /* ───────── Kartu FLAGSHIP (lebar penuh, 2 kolom) ───────── */
            <article class="work-card work-featured reveal">
              <div class="featured-left">
                <p class="work-flagship">
                  <span class="flagship-line" aria-hidden="true" />
                  Flagship · /{pad(i)}
                </p>
                <h3 class="work-title work-title-lg">{w.name}</h3>
                {w.status && <span class="work-badge">{w.status}</span>}
                {w.tags && w.tags.length > 0 && (
                  <ul class="work-tags">
                    {w.tags.map((t) => <li>{t}</li>)}
                  </ul>
                )}
              </div>

              <div class="featured-right">
                {sections(w).map((s) => (
                  <div class="work-block">
                    <p class="work-label">{s.label}</p>
                    <p class="work-text">{s.text}</p>
                  </div>
                ))}
              </div>
            </article>
          ) : (
            /* ───────── Kartu biasa ───────── */
            <article class={`work-card work-item ${i <= 2 ? 'is-half' : 'is-third'} reveal`}>
              <div class="work-head">
                <span class="work-index">/{pad(i)}</span>
                {w.status && <span class="work-badge">{w.status}</span>}
              </div>

              <h3 class="work-title">{w.name}</h3>

              {sections(w).map((s) => (
                <div class="work-block">
                  <p class="work-label">{s.label}</p>
                  <p class="work-text">{s.text}</p>
                </div>
              ))}

              {w.tags && w.tags.length > 0 && (
                <ul class="work-tags work-tags-bottom">
                  {w.tags.map((t) => <li>{t}</li>)}
                </ul>
              )}
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('#certifications .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.05 }
    );
    io.observe(el);
  });
</script>

<style>
  /*
    Font: tambahkan di <head> layout kamu agar tampilan persis gambar:
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  */
  #certifications {
    --w-bg: rgba(8, 14, 32, 0.72);
    --w-bg-featured: rgba(9, 18, 40, 0.82);
    --w-border: rgba(148, 163, 184, 0.18);
    --w-accent: #1e9bff; /* samakan dengan warna "MY WORK" */
    --w-text: #f4f4f5;
    --w-body: #a9b4c8;
    --w-muted: #7c8aa5;
    --w-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --w-display: 'Space Grotesk', 'Inter', system-ui, sans-serif;
  }

  /* Grid 6 kolom: featured = 6, kartu 2 & 3 = 3 + 3, sisanya = 2 + 2 + 2 */
  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .work-grid {
      grid-template-columns: repeat(6, 1fr);
    }
    .work-featured {
      grid-column: span 6;
    }
    .is-half {
      grid-column: span 3;
    }
    .is-third {
      grid-column: span 2;
    }
  }

  /* Kartu dasar: sudut tajam, border tipis */
  .work-card {
    background: var(--w-bg);
    border: 1px solid var(--w-border);
    border-radius: 0;
    padding: 1.5rem;
    text-align: left;
    transition: border-color 0.2s ease;
  }
  .work-card:hover {
    border-color: rgba(30, 155, 255, 0.45);
  }

  /* Featured */
  .work-featured {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 2rem;
    border-top: 2px solid var(--w-accent);
    background:
      radial-gradient(circle at 100% 100%, rgba(30, 155, 255, 0.08), transparent 55%),
      var(--w-bg-featured);
    border-color: rgba(30, 155, 255, 0.35);
    border-top-color: var(--w-accent);
  }
  @media (min-width: 768px) {
    .work-featured {
      grid-template-columns: 1.1fr 1fr;
      gap: 0;
    }
    .featured-left {
      padding-right: 2rem;
    }
    .featured-right {
      padding-left: 2rem;
      border-left: 1px solid var(--w-border);
    }
  }
  .featured-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .work-flagship {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-family: var(--w-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--w-accent);
  }
  .flagship-line {
    display: inline-block;
    width: 1.1rem;
    height: 1px;
    background: var(--w-accent);
  }

  /* Judul */
  .work-title {
    margin: 0;
    font-family: var(--w-display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--w-text);
  }
  .work-title-lg {
    font-size: clamp(2rem, 4vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  /* Header kartu biasa: /02 kiri, badge kanan */
  .work-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .work-index {
    font-family: var(--w-mono);
    font-size: 0.7rem;
    color: var(--w-muted);
  }

  /* Badge status (outline oranye, kotak) */
  .work-badge {
    display: inline-block;
    padding: 0.28rem 0.6rem;
    border: 1px solid var(--w-accent);
    background: rgba(30, 155, 255, 0.08);
    color: var(--w-accent);
    font-family: var(--w-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Problem / Contribution / Outcome */
  .work-block {
    margin-top: 1.1rem;
  }
  .work-block:first-of-type {
    margin-top: 0;
  }
  .work-item .work-title {
    margin-bottom: 1.1rem;
  }
  .work-label {
    margin: 0 0 0.35rem;
    font-family: var(--w-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--w-accent);
  }
  .work-text {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--w-body);
    max-width: 62ch;
  }
  .featured-right .work-block:first-child {
    margin-top: 0;
  }

  /* Tag teknologi: kotak, mono, border abu */
  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .work-tags li {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--w-border);
    background: rgba(255, 255, 255, 0.02);
    font-family: var(--w-mono);
    font-size: 0.62rem;
    color: var(--w-muted);
  }
  .work-tags-bottom {
    margin-top: 1.5rem;
  }

  /* Tema terang (mengikuti pola data-theme di kode kamu) */
  :global([data-theme='light']) #certifications {
    --w-bg: #ffffff;
    --w-bg-featured: #f4f9ff;
    --w-border: #e4e4e7;
    --w-text: #18181b;
    --w-body: #52525b;
    --w-muted: #71717a;
  }
</style>