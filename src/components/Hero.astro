 <figure class="polaroid">
      <img 
      src="/images/projects/foto_profil.jpg"
      alt="Foto Profil"
       class="polaroid-img"
        />            
 </figure>   --> 
 
<!--<!-- Ganti dari <article class="project-frame"> sampai akhir file dengan ini -->
          <article class="project-frame" id="project-frame">
            <figure class="photo-frame">
              <div class="photo-media">
                <img
                  src="/images/projects/foto_profil.jpg"
                  alt="Foto Profil"
                  class="photo-img"
                  loading="eager"
                />
                <span class="photo-corner tl" aria-hidden="true"></span>
                <span class="photo-corner tr" aria-hidden="true"></span>
                <span class="photo-corner bl" aria-hidden="true"></span>
                <span class="photo-corner br" aria-hidden="true"></span>
              </div>
              <figcaption class="photo-caption">
                <span>/Profile</span>
                <span>{personalData.name}</span>
              </figcaption>
            </figure>
          </article>
        </div>
      </div>
    </div>
  </div>
</section>

<div id="pf-overlay" aria-hidden="true"></div>

<style>
  /* ===== Photo frame: kotak, serasi dengan kartu section lain ===== */
  .photo-frame {
    --pf-accent: #1e9bff;
    --pf-border: rgba(148, 163, 184, 0.18);

    position: relative;
    isolation: isolate;
    width: 100%;
    max-width: 340px;
    margin: 0 14px 14px 0;
    padding: 0.75rem;
    background: rgba(8, 14, 32, 0.72);
    border: 1px solid var(--pf-border);
    border-radius: 0;
    box-shadow: 0 0 80px rgba(30, 155, 255, 0.1);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  /* Garis biru yang bergeser di belakang bingkai (efek berlapis) */
  .photo-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border: 1px solid rgba(30, 155, 255, 0.45);
    transform: translate(14px, 14px);
    transition: transform 0.3s ease;
    pointer-events: none;
  }
  .photo-frame:hover {
    border-color: rgba(30, 155, 255, 0.45);
    box-shadow: 0 0 100px rgba(30, 155, 255, 0.18);
  }
  .photo-frame:hover::before {
    transform: translate(8px, 8px);
  }

  .photo-media {
    position: relative;
    overflow: hidden;
  }
  .photo-img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
    border-radius: 0;
    filter: saturate(0.92) contrast(1.04);
    transition: filter 0.4s ease;
  }

  /* Tint biru + gradasi gelap di bawah supaya foto menyatu dengan latar */
  .photo-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 55%, rgba(8, 14, 32, 0.7) 100%),
      linear-gradient(135deg, rgba(30, 155, 255, 0.2), transparent 55%);
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .photo-frame:hover .photo-media::after {
    opacity: 0.45;
  }
  .photo-frame:hover .photo-img {
    filter: saturate(1) contrast(1.02);
  }

  /* Sudut bracket biru */
  .photo-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    z-index: 1;
    border: 0 solid var(--pf-accent);
    pointer-events: none;
  }
  .photo-corner.tl { top: 8px;    left: 8px;  border-top-width: 2px;    border-left-width: 2px; }
  .photo-corner.tr { top: 8px;    right: 8px; border-top-width: 2px;    border-right-width: 2px; }
  .photo-corner.bl { bottom: 8px; left: 8px;  border-bottom-width: 2px; border-left-width: 2px; }
  .photo-corner.br { bottom: 8px; right: 8px; border-bottom-width: 2px; border-right-width: 2px; }

  /* Caption mono */
  .photo-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--pf-border);
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7c8aa5;
  }
  .photo-caption span:first-child {
    color: var(--pf-accent);
  }

  @media (max-width: 640px) {
    .photo-frame {
      max-width: 260px;
      margin: 0 10px 10px 0;
    }
    .photo-frame::before {
      transform: translate(10px, 10px);
    }
  }

  [data-theme='light'] .photo-frame {
    --pf-border: #e4e4e7;
    background: #ffffff;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
  }
  [data-theme='light'] .photo-caption {
    color: #71717a;
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-frame,
    .photo-frame::before,
    .photo-img,
    .photo-media::after {
      transition: none;
    }
  }

  /* ===== Social links: kotak, border tipis (sama seperti section Contact) ===== */
  .hero-social-link {
    width: 2.5rem;
    height: 2.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(148, 163, 184, 0.18);
    background: rgba(8, 14, 32, 0.72);
    border-radius: 0;
    color: #7c8aa5;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }
  .hero-social-link:hover {
    color: #1e9bff;
    border-color: #1e9bff;
    background: rgba(30, 155, 255, 0.08);
  }
  .hero-social-link:focus-visible {
    outline: 2px solid #1e9bff;
    outline-offset: 2px;
  }
  [data-theme='light'] .hero-social-link {
    color: #475569;
    background: #ffffff;
    border-color: #e4e4e7;
  }
  [data-theme='light'] .hero-social-link:hover {
    color: #1e9bff;
    border-color: #1e9bff;
  }

  /* ===== Tombol: sudut kotak ===== */
  .btn-primary,
  .btn-secondary {
    border-radius: 0;
  }

  /* ===== Spotlight ===== */
  .spotlight-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .spotlight {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .spotlight-1 {
    width: 90vw; height: 90vw;
    max-width: 900px; max-height: 900px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.09) 0%, transparent 65%);
    filter: blur(24px);
    animation: drift-1 22s ease-in-out infinite alternate;
  }
  .spotlight-2 {
    width: 70vw; height: 70vw;
    max-width: 700px; max-height: 700px;
    background: radial-gradient(circle, rgba(14, 165, 233, 0.07) 0%, transparent 65%);
    filter: blur(36px);
    animation: drift-2 28s ease-in-out infinite alternate;
  }
  .spotlight-3 {
    width: 40vw; height: 40vw;
    max-width: 400px; max-height: 400px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.08) 0%, transparent 60%);
    filter: blur(12px);
    animation: drift-3 18s ease-in-out infinite alternate;
  }

  @keyframes drift-1 {
    0%   { transform: translate(-20%, -10%); opacity: 0.5; }
    25%  { transform: translate(40%, 10%);   opacity: 1; }
    50%  { transform: translate(60%, 50%);   opacity: 0.6; }
    75%  { transform: translate(10%, 70%);   opacity: 0.9; }
    100% { transform: translate(-10%, 40%);  opacity: 0.4; }
  }
  @keyframes drift-2 {
    0%   { transform: translate(80%, 60%);  opacity: 0.6; }
    33%  { transform: translate(10%, 80%);  opacity: 1; }
    66%  { transform: translate(-10%, 20%); opacity: 0.5; }
    100% { transform: translate(70%, -10%); opacity: 0.8; }
  }
  @keyframes drift-3 {
    0%   { transform: translate(50%, 20%); opacity: 0.3; }
    40%  { transform: translate(80%, 60%); opacity: 0.8; }
    70%  { transform: translate(20%, 80%); opacity: 0.4; }
    100% { transform: translate(60%, 10%); opacity: 0.9; }
  }

  /* ===== Text backdrop: kartu kotak, sama seperti section lain ===== */
  .text-backdrop {
    position: relative;
    z-index: 2;
    background: rgba(8, 14, 32, 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 0;
    padding: 1.25rem 1.5rem;
    transition: border-color 0.2s ease;
  }
  .text-backdrop:hover {
    border-color: rgba(30, 155, 255, 0.45);
  }
  [data-theme='light'] .text-backdrop {
    background: rgba(255, 255, 255, 0.85);
    border-color: #e4e4e7;
  }

  /* ===== Portrait peek ===== */
  .portrait-peek-wrapper {
    display: block;
    position: absolute;
    right: -4rem;
    top: -4.5%;
    z-index: 2;
    pointer-events: none;
  }
  .portrait-peek-img {
    display: block;
    width: 280px;
    height: auto;
    transform: translateY(0);
    animation: none;
    animation-delay: 5s;
    pointer-events: auto;
    filter: drop-shadow(0 0 0 rgba(0, 0, 0, 0));
    transition: filter 0.5s ease-out;
  }
  .portrait-peek-img:hover {
    filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.65)) drop-shadow(0 10px 10px rgba(0, 0, 0, 0.4));
  }

  @media (min-width: 1280px) and (max-width: 1535px) {
    .text-backdrop { width: 125%; }
    .portrait-peek-img { transform: scale(0.8); }
    .portrait-peek-wrapper { right: calc(-25% + -25px); }
  }
  @media (min-width: 1024px) and (max-width: 1279px) {
    .portrait-peek-img {
      transform: translateY(0) scale(0.58);
      animation: portrait-peek-mobile-horizontal 20s ease-in-out infinite;
      animation-delay: 1s;
    }
    .portrait-peek-wrapper { z-index: 1; }
  }
  @media (min-width: 501px) and (max-width: 1023px) {
    .portrait-peek-img { transform: scale(0.7); }
    .portrait-peek-wrapper {
      top: -10%;
      right: -25px;
      transform: scaleX(-1);
    }
  }
  @media (min-width: 440px) and (max-width: 500px) {
    .portrait-peek-wrapper {
      top: -8.5%;
      right: -15%;
      transform: scaleX(-1);
    }
    .portrait-peek-img { transform: scale(0.5); }
  }
  @media (min-width: 400px) and (max-width: 439px) {
    .portrait-peek-wrapper {
      top: -8.5%;
      right: -25%;
      transform: scaleX(-1);
    }
    .portrait-peek-img { transform: scale(0.45); }
  }
  @media (max-width: 399px) {
    .portrait-peek-wrapper { display: none; }
  }

  @keyframes portrait-peek-mobile-horizontal {
    0%       { transform: translate(0) rotate(0) scale(0.58); }
    10%      { transform: translate(100px) rotate(0) scale(0.58); }
    26%      { transform: translate(115px) rotate(12deg) scale(0.58); }
    45%      { transform: translate(134px) rotate(25deg) scale(0.6); }
    55%      { transform: translate(100px) rotate(20deg) scale(0.58); }
    70%, 100% { transform: translate(0) rotate(0) scale(0.58); }
  }

  /* ===== Misc ===== */
  @media (max-width: 1023px) {
    #home p.text-sm.tracking-widest.text-highlight.uppercase { display: none; }
    #home { padding-top: 3rem; }
  }
  [data-theme='light'] .gradient-text {
    background: linear-gradient(90deg, #716ae3, #4984a2, #716ae3);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    animation: gradient-shift 5s linear infinite;
  }
</style>
<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.hero-slide'));
  const badges = Array.from(document.querySelectorAll<HTMLElement>('.hero-badge-icon'));
  const dots = Array.from(document.querySelectorAll<HTMLElement>('.slider-dot'));
  const counter = document.querySelector<HTMLElement>('.slider-counter');
  const total = slides.length;
  let current = 0;
  let autoTimer: ReturnType<typeof setInterval>;

  function goTo(next: number, direction: 1 | -1 = 1) {
    if (next === current || total === 0) return;
    const prev = current;
    current = next;

    slides[prev].style.transform = `translateX(${direction * -100}%)`;
    slides[prev].style.opacity = '0';

    slides[current].style.transition = 'none';
    slides[current].style.transform = `translateX(${direction * 100}%)`;
    slides[current].style.opacity = '0';

    slides[current].getBoundingClientRect();
    slides[current].style.transition = '';
    slides[current].style.transform = 'translateX(0)';
    slides[current].style.opacity = '1';

    badges[prev].style.opacity = '0';
    badges[prev].style.transform = 'scale(0.4)';
    badges[current].style.opacity = '1';
    badges[current].style.transform = 'scale(1)';

    dots.forEach((d, i) => {
      if (i === current) {
        d.style.background = '#6366f1';
        d.style.width = '1.25rem';
      } else {
        d.style.background = 'rgba(255,255,255,0.25)';
        d.style.width = '0.375rem';
      }
    });

    if (counter) counter.textContent = `${current + 1} / ${total}`;
  }

  function nextSlide() {
    goTo((current + 1) % total, 1);
  }
  function prevSlide() {
    goTo((current - 1 + total) % total, -1);
  }

  function resetTimer() {
    clearInterval(autoTimer);
    autoTimer = setInterval(nextSlide, 4500);
  }

  document.getElementById('slider-prev')?.addEventListener('click', () => {
    prevSlide();
    resetTimer();
  });
  document.getElementById('slider-next')?.addEventListener('click', () => {
    nextSlide();
    resetTimer();
  });

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      goTo(i, i > current ? 1 : -1);
      resetTimer();
    });
  });

  let touchStartX = 0;
  const frame = document.querySelector('.hero-slide')?.parentElement;
  frame?.addEventListener(
    'touchstart',
    (e: TouchEvent) => {
      touchStartX = e.touches[0].clientX;
    },
    { passive: true }
  );
  frame?.addEventListener('touchend', (e: TouchEvent) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 40) {
      dx < 0 ? nextSlide() : prevSlide();
      resetTimer();
    }
  });

  if (total > 0) resetTimer();

  // Clicking a hero slide opens the matching project card modal in Projects.astro.
  // data-project-index maps hero slides to their original index in the full projects list.
  slides.forEach((slide) => {
    slide.addEventListener('click', (e: MouseEvent) => {
      if ((e.target as HTMLElement).closest('button')) return;
      const idx = (slide as HTMLElement).dataset.projectIndex;
      // Grid layout: click opens the project modal
      const gridCard = document.querySelector<HTMLElement>(`.project-card[data-index="${idx}"]`);
      if (gridCard) { gridCard.click(); return; }
      // Showcase layout: scroll to the matching feature card
      document.querySelector<HTMLElement>(`.project-feature[data-index="${idx}"]`)
        ?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });

  const heroSection = document.getElementById('home');
  if (heroSection && total > 0) {
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          resetTimer();
        } else {
          clearInterval(autoTimer);
        }
      },
      { threshold: 0.1 }
    ).observe(heroSection);
  }

  const projectFrame = document.getElementById('project-frame') as HTMLElement | null;
  const pfHeader = document.getElementById('project-frame-header') as HTMLElement | null;
  const pfFrameParent = projectFrame?.parentElement as HTMLElement | null;
  // pfDx/pfDy: accumulated translation of the draggable project frame from its original position.
  // pfOx/pfOy: pointer position at drag start minus pfDx/pfDy, used to compute the new offset on move.
  let pfDx = 0,
    pfDy = 0,
    pfOx = 0,
    pfOy = 0;

  function pfDragStart(e: MouseEvent | TouchEvent) {
    if ((e.target as HTMLElement).closest('button')) return;
    e.preventDefault();
    const t = (e as TouchEvent).touches?.[0];
    pfOx = (t?.clientX ?? (e as MouseEvent).clientX) - pfDx;
    pfOy = (t?.clientY ?? (e as MouseEvent).clientY) - pfDy;
    document.addEventListener('mousemove', pfDragMove);
    document.addEventListener('mouseup', pfDragEnd);
    document.addEventListener('touchmove', pfDragMove as EventListener, { passive: false });
    document.addEventListener('touchend', pfDragEnd);
    if (pfHeader) pfHeader.style.cursor = 'grabbing';
  }

  function pfDragMove(e: MouseEvent | TouchEvent) {
    e.preventDefault();
    const t = (e as TouchEvent).touches?.[0];
    pfDx = (t?.clientX ?? (e as MouseEvent).clientX) - pfOx;
    pfDy = (t?.clientY ?? (e as MouseEvent).clientY) - pfOy;
    if (projectFrame && !projectFrame.classList.contains('pf-fullscreen')) {
      projectFrame.style.transform = `translate(${pfDx}px,${pfDy}px)`;
    }
  }

  function pfDragEnd() {
    document.removeEventListener('mousemove', pfDragMove);
    document.removeEventListener('mouseup', pfDragEnd);
    document.removeEventListener('touchmove', pfDragMove as EventListener);
    document.removeEventListener('touchend', pfDragEnd);
    if (pfHeader) pfHeader.style.cursor = 'grab';
  }

  pfHeader?.addEventListener('mousedown', pfDragStart as EventListener);
  pfHeader?.addEventListener('touchstart', pfDragStart as EventListener, { passive: false });

  const pfCloseBtn = document.getElementById('pf-close-btn');
  const pfBody = projectFrame?.querySelector<HTMLElement>('.pf-body');
  const pfPrev = document.getElementById('slider-prev') as HTMLElement | null;
  const pfNext = document.getElementById('slider-next') as HTMLElement | null;
  let pfCollapsed = false;

  pfCloseBtn?.addEventListener('click', () => {
    if (projectFrame?.classList.contains('pf-fullscreen')) {
      exitFullscreen();
      return;
    }
    pfCollapsed = !pfCollapsed;
    if (pfBody) pfBody.style.visibility = pfCollapsed ? 'hidden' : '';
    if (projectFrame) projectFrame.style.height = pfCollapsed ? 'calc(30px + 8px)' : '';
    pfPrev?.classList.toggle('pf-nav-hidden', pfCollapsed);
    pfNext?.classList.toggle('pf-nav-hidden', pfCollapsed);
  });

  const pfFullBtn = document.getElementById('pf-fullscreen-btn');
  const pfOverlay = document.getElementById('pf-overlay');
  const pfIconExp =
    '<path d="M344 0H488c13.3 0 24 10.7 24 24V168c0 9.7-5.8 18.5-14.8 22.2s-19.3 1.7-26.2-5.2l-39-39-87 87c-9.4 9.4-24.6 9.4-33.9 0l-32-32c-9.4-9.4-9.4-24.6 0-33.9l87-87L327 41c-6.9-6.9-8.9-17.2-5.2-26.2S334.3 0 344 0zM168 512H24c-13.3 0-24-10.7-24-24V344c0-9.7 5.8-18.5 14.8-22.2s19.3-1.7 26.2 5.2l39 39 87-87c9.4-9.4 24.6-9.4 33.9 0l32 32c9.4 9.4 9.4 24.6 0 33.9l-87 87 39 39c6.9 6.9 8.9 17.2 5.2 26.2s-12.5 14.8-22.2 14.8z"/>';
  const pfIconShrink =
    '<path d="M439 7c9.4-9.4 24.6-9.4 33.9 0l32 32c9.4 9.4 9.4 24.6 0 33.9l-87 87 39 39c6.9 6.9 8.9 17.2 5.2 26.2s-12.5 14.8-22.2 14.8H296c-13.3 0-24-10.7-24-24V72c0-9.7 5.8-18.5 14.8-22.2s19.3 1.7-26.2 5.2l39 39L439 7zM72 272H216c13.3 0 24 10.7 24 24V440c0 9.7-5.8 18.5-14.8 22.2s-19.3 1.7-26.2-5.2l-39-39L73 505c-9.4 9.4-24.6 9.4-33.9 0L7 473c-9.4-9.4-9.4-24.6 0-33.9l87-87L55 313c-6.9-6.9-8.9-17.2-5.2-26.2s12.5-14.8 22.2-14.8z"/>';

  function exitFullscreen() {
    if (!projectFrame) return;
    projectFrame.classList.remove('pf-fullscreen');
    pfOverlay?.classList.remove('pf-overlay-active');
    const svg = pfFullBtn?.querySelector('svg');
    if (svg) svg.innerHTML = pfIconExp;
    if (pfFrameParent) pfFrameParent.appendChild(projectFrame);
  }

  pfFullBtn?.addEventListener('click', () => {
    if (!projectFrame) return;
    const isFs = !projectFrame.classList.contains('pf-fullscreen');
    if (isFs) {
      pfDx = 0;
      pfDy = 0;
      projectFrame.style.transform = '';
      document.body.appendChild(projectFrame);
      projectFrame.classList.add('pf-fullscreen');
      pfOverlay?.classList.add('pf-overlay-active');
      const svg = pfFullBtn.querySelector('svg');
      if (svg) svg.innerHTML = pfIconShrink;
    } else {
      exitFullscreen();
    }
  });

  pfOverlay?.addEventListener('click', exitFullscreen);

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && projectFrame?.classList.contains('pf-fullscreen')) exitFullscreen();
  });

  document.querySelectorAll('#home .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.05 }
    );
    io.observe(el);
  });

  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  const wrapper = document.getElementById('hero-canvas-wrapper') as HTMLElement | null;
  const section = document.getElementById('home') as HTMLElement | null;
  if (!canvas || !wrapper || !section) {
    console.error('Hero canvas init failed');
  } else {
    const ctx = canvas.getContext('2d')!;
    const BLOCK = 8; // fine grid cell size
    const DOT = 2; // dot diameter in px
    const COLOR_A = '#6366f1';
    const COLOR_B = '#38bdf8';
    const GRID_BG = '#09090b';
    const GRID_STROKE = '#111827';
    const DECAY = 1 / 14;

    let cols = 0,
      rows = 0;

    let timers = new Float32Array(0);

    function resize() {
      const w = wrapper!.offsetWidth;
      const h = wrapper!.offsetHeight;
      canvas!.width = w;
      canvas!.height = h;
      cols = Math.ceil(w / BLOCK) + 1;
      rows = Math.ceil(h / BLOCK) + 1;
      timers = new Float32Array(cols * rows);
    }

    function drawGrid() {
      ctx.fillStyle = GRID_BG;
      ctx.fillRect(0, 0, canvas!.width, canvas!.height);
      ctx.strokeStyle = GRID_STROKE;
      ctx.lineWidth = 0.4;
      for (let x = 0; x <= canvas!.width; x += BLOCK) {
        ctx.beginPath();
        ctx.moveTo(x + 0.5, 0);
        ctx.lineTo(x + 0.5, canvas!.height);
        ctx.stroke();
      }
      for (let y = 0; y <= canvas!.height; y += BLOCK) {
        ctx.beginPath();
        ctx.moveTo(0, y + 0.5);
        ctx.lineTo(canvas!.width, y + 0.5);
        ctx.stroke();
      }
    }

    function drawDot(col: number, row: number, t: number) {
      const cx = col * BLOCK + BLOCK / 2;
      const cy = row * BLOCK + BLOCK / 2;
      const color = (col + row) % 2 === 0 ? COLOR_A : COLOR_B;
      ctx.globalAlpha = t * 0.72;
      ctx.fillStyle = color;
      ctx.fillRect(Math.floor(cx - DOT / 2), Math.floor(cy - DOT / 2), DOT, DOT);
      ctx.globalAlpha = 1.0;
    }

    function animate() {
      drawGrid();
      for (let i = 0; i < timers.length; i++) {
        if (timers[i] > 0) {
          drawDot(i % cols, Math.floor(i / cols), timers[i]);
          timers[i] = Math.max(0, timers[i] - DECAY);
        }
      }
    }

    section.addEventListener('mousemove', (e: MouseEvent) => {
      if (mql.matches || !heroVisible) return;
      const rect = wrapper!.getBoundingClientRect();
      const mx = e.clientX - rect.left;
      const my = e.clientY - rect.top;
      const cx = Math.floor(mx / BLOCK);
      const cy = Math.floor(my / BLOCK);
      const radius = 2;
      for (let dy = -radius; dy <= radius; dy++) {
        for (let dx = -radius; dx <= radius; dx++) {
          if (dx * dx + dy * dy > radius * radius) continue;
          const nx = cx + dx,
            ny = cy + dy;
          if (nx >= 0 && nx < cols && ny >= 0 && ny < rows) {
            const idx = ny * cols + nx;
            if (timers[idx] === 0) timers[idx] = 1.0;
          }
        }
      }
      startAnimation();
    });

    const ro = new ResizeObserver(() => resize());
    ro.observe(wrapper);
    resize();

    const mql = window.matchMedia('(prefers-reduced-motion: reduce)');
    let rafId = 0;
    let heroVisible = true;

    // Self-terminating loop: the rAF cycle stops as soon as all dot timers reach 0,
    // so the canvas draws nothing and burns no CPU when the user's cursor is idle.
    function startAnimation() {
      if (rafId !== 0) return;
      function loop() {
        animate();
        let anyActive = false;
        for (let i = 0; i < timers.length; i++) {
          if (timers[i] > 0) {
            anyActive = true;
            break;
          }
        }
        rafId = anyActive ? requestAnimationFrame(loop) : 0;
      }
      rafId = requestAnimationFrame(loop);
    }

    drawGrid();

    mql.addEventListener('change', (e: MediaQueryListEvent) => {
      if (e.matches) {
        cancelAnimationFrame(rafId);
        rafId = 0;
        drawGrid();
      }
    });

    new IntersectionObserver(
      ([entry]) => {
        heroVisible = entry.isIntersecting;
        if (!entry.isIntersecting) {
          cancelAnimationFrame(rafId);
          rafId = 0;
        }
      },
      { threshold: 0.05 }
    ).observe(section);
  }
</script>
