---
import expertiseFile from '../data/expertise.json';

type ExpertiseItem = {
  key: string;
  icon?: string;
  title: string;
  company: string;
  location?: string;
  periode?: string;
  description: string;
  tags?: string[];
};

const expertiseData = expertiseFile.items as ExpertiseItem[];

// Pecah deskripsi yang diawali "•" menjadi poin-poin
const toPoints = (text: string) =>
  text.includes('•')
    ? text.split('•').map((s) => s.trim()).filter(Boolean)
    : [];
---

<section id="expertise" class="py-20" style="scroll-margin-top: 80px;">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14 reveal">
      <p class="text-sm font-semibold tracking-widest text-highlight uppercase mb-3">What I do</p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title">Expertise</h2>
    </div>

    <div class="timeline max-w-4xl mx-auto">
      {
        expertiseData.map((item, i) => {
          const points = toPoints(item.description);
          return (
            <article class="timeline-item reveal" style={`transition-delay:${i * 0.08}s`}>
              <span class="timeline-dot" aria-hidden="true"></span>

              <div class="timeline-card">
                <div class="timeline-head">
                  <h3 class="timeline-title">{item.title}</h3>
                  {item.periode && <span class="timeline-periode">{item.periode}</span>}
                </div>

                {item.company && (
                  <p class="timeline-meta">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M4 21V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v16" />
                      <path d="M14 10h5a1 1 0 0 1 1 1v10" />
                      <path d="M8 8h2M8 12h2M8 16h2" />
                    </svg>
                    {item.company}
                  </p>
                )}

                {item.location && (
                  <p class="timeline-meta">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z" />
                      <circle cx="12" cy="10" r="2.5" />
                    </svg>
                    {item.location}
                  </p>
                )}

                {points.length > 0 ? (
                  <ul class="timeline-points">
                    {points.map((p) => <li>{p}</li>)}
                  </ul>
                ) : (
                  <p class="timeline-desc">{item.description}</p>
                )}

                {item.tags && item.tags.length > 0 && (
                  <ul class="timeline-tags">
                    {item.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('#expertise .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.1 }
    );
    io.observe(el);
  });
</script>

<style>
  /* Variabel sama dengan section Featured Work & Skills */
  #expertise {
    --w-bg: rgba(8, 14, 32, 0.72);
    --w-border: rgba(148, 163, 184, 0.18);
    --w-accent: #1e9bff;
    --w-text: #f4f4f5;
    --w-body: #a9b4c8;
    --w-muted: #7c8aa5;
    --w-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --w-display: 'Space Grotesk', 'Inter', system-ui, sans-serif;
  }

  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-left: 2.75rem;
  }

  /* garis vertikal */
  .timeline::before {
    content: '';
    position: absolute;
    left: 0.7rem;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--w-border);
  }

  .timeline-item {
    position: relative;
  }

  /* titik di garis: kotak */
  .timeline-dot {
    position: absolute;
    left: -2.45rem;
    top: 1.75rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 0;
    background: var(--w-accent);
    box-shadow: 0 0 0 4px rgba(30, 155, 255, 0.15);
  }

  /* Kartu: kotak, border tipis */
  .timeline-card {
    border: 1px solid var(--w-border);
    border-radius: 0;
    padding: 1.5rem;
    background: var(--w-bg);
    text-align: left;
    transition: border-color 0.2s ease;
  }
  .timeline-card:hover {
    border-color: rgba(30, 155, 255, 0.45);
  }

  .timeline-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }
  .timeline-head .timeline-title {
    margin: 0;
  }

  .timeline-title {
    color: var(--w-text);
    font-family: var(--w-display);
    font-size: clamp(1.15rem, 2.2vw, 1.35rem);
    font-weight: 600;
    line-height: 1.2;
  }

  /* Periode: badge outline biru */
  .timeline-periode {
    display: inline-block;
    padding: 0.28rem 0.6rem;
    border: 1px solid var(--w-accent);
    background: rgba(30, 155, 255, 0.08);
    color: var(--w-accent);
    font-family: var(--w-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .timeline-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.4rem;
    color: var(--w-muted);
    font-family: var(--w-mono);
    font-size: 0.72rem;
  }

  .icon {
    width: 0.9rem;
    height: 0.9rem;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .timeline-desc {
    margin: 1rem 0 0;
    color: var(--w-body);
    font-size: 0.85rem;
    line-height: 1.65;
  }

  .timeline-points {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .timeline-points li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--w-body);
    font-size: 0.85rem;
    line-height: 1.65;
  }
  .timeline-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 0;
    background: var(--w-accent);
  }

  /* Tag: kotak, mono, border abu */
  .timeline-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .timeline-tags li {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--w-border);
    background: rgba(255, 255, 255, 0.02);
    border-radius: 0;
    color: var(--w-muted);
    font-family: var(--w-mono);
    font-size: 0.62rem;
  }

  /* Tema terang */
  :global([data-theme='light']) #expertise {
    --w-bg: #ffffff;
    --w-border: #e4e4e7;
    --w-text: #18181b;
    --w-body: #52525b;
    --w-muted: #71717a;
  }

  @media (max-width: 640px) {
    .timeline {
      padding-left: 2.1rem;
    }
    .timeline::before {
      left: 0.45rem;
    }
    .timeline-dot {
      left: -1.95rem;
    }
    .timeline-card {
      padding: 1.2rem;
    }
    .timeline-head {
      flex-direction: column;
      gap: 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-card {
      transition: none;
    }
  }
</style>