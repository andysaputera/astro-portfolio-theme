---
import skillsData from '../data/skills.json';

const { section, categories } = skillsData;
---

<section id="skills" class="py-24" style="scroll-margin-top: 80px;">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 reveal">
      <p class="text-sm font-semibold tracking-widest text-highlight uppercase mb-3">
        {section.eyebrow}
      </p>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title">{section.heading}</h2>
    </div>

    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-5">
      {
        categories.map((category, ci) => (
          <article
            class:list={['skills-card reveal', ci === 2 && 'lg:col-span-2']}
            style={`transition-delay: ${ci * 0.1}s;`}
          >
            <h3 class="category-title">{category.title}</h3>

            <ul class="skill-list">
              {category.skills.map((skill) => (
                <li class="skill-chip">{skill}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Variabel sama dengan section Featured Work */
  #skills {
    --w-bg: rgba(8, 14, 32, 0.72);
    --w-border: rgba(148, 163, 184, 0.18);
    --w-accent: #1e9bff;
    --w-text: #f4f4f5;
    --w-body: #a9b4c8;
    --w-muted: #7c8aa5;
    --w-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --w-display: 'Space Grotesk', 'Inter', system-ui, sans-serif;
  }

  /* ── Kartu kategori: kotak, border tipis ─────────── */
  .skills-card {
    background: var(--w-bg);
    border: 1px solid var(--w-border);
    border-radius: 0;
    padding: 1.5rem;
    text-align: left;
    transition: border-color 0.2s ease;
  }
  .skills-card:hover {
    border-color: rgba(30, 155, 255, 0.45);
  }

  .category-title {
    margin: 0 0 1.25rem;
    font-family: var(--w-display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--w-text);
  }

  /* ── Skill chips: kotak, mono, border abu ────────── */
  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .skill-chip {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--w-border);
    background: rgba(255, 255, 255, 0.02);
    font-family: var(--w-mono);
    font-size: 0.68rem;
    line-height: 1.3;
    color: var(--w-body);
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }
  .skill-chip:hover {
    color: var(--w-accent);
    border-color: var(--w-accent);
    background: rgba(30, 155, 255, 0.08);
  }

  /* ── Tema terang ─────────────────────────────────── */
  :global([data-theme='light']) #skills {
    --w-bg: #ffffff;
    --w-border: #e4e4e7;
    --w-text: #18181b;
    --w-body: #52525b;
    --w-muted: #71717a;
  }
  :global([data-theme='light']) .skill-chip {
    background: #f4f4f5;
  }

  @media (prefers-reduced-motion: reduce) {
    .skills-card,
    .skill-chip {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll('#skills .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.1 }
    );
    io.observe(el);
  });
</script>