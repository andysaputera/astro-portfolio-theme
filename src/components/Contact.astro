---
import personalData from '../data/personal.json';
import siteData from '../data/site.json';
import { getSocialLinks } from '../lib/socialLinks';

const socialLinks = getSocialLinks(personalData as unknown as Record<string, string | string[]>);
---

<section
  id="contact"
  class="py-24"
  style="background: var(--bg-section); position: relative; z-index: 5; scroll-margin-top: 80px;"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12 reveal">
        <p class="text-sm font-semibold tracking-widest text-highlight uppercase mb-3">
          Contact me
        </p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold section-title">Let's talk.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <div class="space-y-4 reveal" style="transition-delay: 0.1s;">
          {personalData.email && (
            <div class="contact-card">
              <div class="contact-row">
                <div class="contact-icon">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="contact-label">Email</h3>
                  <a href={`mailto:${personalData.email}`} class="contact-value contact-link">
                    {personalData.email}
                  </a>
                </div>
              </div>
            </div>
          )}

          {personalData.phone && (
            <div class="contact-card">
              <div class="contact-row">
                <div class="contact-icon">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                </div>
                <div>
                  <h3 class="contact-label">Phone</h3>
                  <a href={personalData.phoneTel} class="contact-value contact-link">
                    {personalData.phone}
                  </a>
                </div>
              </div>
            </div>
          )}

          <div class="contact-card">
            <div class="contact-row">
              <div class="contact-icon">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <h3 class="contact-label">Location</h3>
                <p class="contact-value">{personalData.location}</p>
              </div>
            </div>
          </div>

          {socialLinks.length > 0 && (
            <div class="contact-card">
              <h3 class="contact-label" style="margin-bottom: 1rem;">Where else you can find me</h3>
              <div class="flex flex-wrap gap-3">
                {socialLinks.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer" class="contact-social-link" aria-label={link.label}>
                    <iconify-icon icon={link.icon} width="20" height="20" aria-hidden="true" />
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

        <div class="reveal flex flex-col pl-8" style="transition-delay: 0.2s;">
          <p class="text-slate-400 text-xl mb-6 italic leading-relaxed" style="font-family: 'Inter', sans-serif;">
            Interested in Implementation Specialist, System Analyst, Business Analyst, or Functional Consultant roles where business requirements, system solutions, and real-world operations come together to improve business processes and user experience.
          </p>

          <form id="contact-form" class="space-y-4" novalidate>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <div aria-live="polite" aria-atomic="true" id="form-status" class="sr-only"></div>
              </div>
            </div>
          </form>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('#contact .reveal').forEach((el) => {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('visible');
          io.disconnect();
        }
      },
      { threshold: 0.1 }
    );
    io.observe(el);
  });

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status') as HTMLElement | null;
  const button = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;
  // Stash the button's original inner HTML before mutating it to "Sending…".
  // Restored in the finally block so the button always returns to its original state,
  // including any icon SVG, regardless of whether the request succeeded or failed.
  const BUTTON_HTML = button?.innerHTML ?? 'Send Message';

  function setStatus(msg: string, isError: boolean) {
    if (!status) return;
    status.textContent = msg;
    status.className = isError ? 'mt-3 text-sm text-red-400' : 'mt-3 text-sm text-green-400';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (button) {
      button.disabled = true;
      button.textContent = 'Sending…';
    }
    setStatus('', false);

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(form!),
      });
      const data = (await res.json()) as { success?: boolean; message?: string };
      if (res.ok) {
        setStatus("Message sent! I'll be in touch soon.", false);
        form!.reset();
      } else {
        setStatus(data.message ?? 'Something went wrong. Please try again.', true);
      }
    } catch {
      setStatus('Network error. Check your connection and try again.', true);
    } finally {
      if (button) {
        button.disabled = false;
        button.innerHTML = BUTTON_HTML;
      }
    }
  });
</script>

<style>
  /* Variabel sama dengan section Featured Work, Skills & Expertise */
  #contact {
    --w-bg: rgba(8, 14, 32, 0.72);
    --w-border: rgba(148, 163, 184, 0.18);
    --w-accent: #1e9bff;
    --w-text: #f4f4f5;
    --w-body: #a9b4c8;
    --w-muted: #7c8aa5;
    --w-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  /* Kartu: kotak, border tipis */
  .contact-card {
    background: var(--w-bg);
    border: 1px solid var(--w-border);
    border-radius: 1;
    padding: 1.25rem 1.5rem;
    text-align: left;
    transition: border-color 0.2s ease;
  }
  .contact-card:hover {
    border-color: rgba(30, 155, 255, 0.45);
  }

  .contact-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Ikon: kotak dengan border biru tipis */
  .contact-icon {
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(30, 155, 255, 0.35);
    background: rgba(30, 155, 255, 0.08);
    border-radius: 0;
    color: var(--w-accent);
  }

  /* Label mono biru, sama seperti Problem / Contribution / Outcome */
  .contact-label {
    margin: 0 0 0.3rem;
    font-family: var(--w-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--w-accent);
  }
  .contact-value {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--w-body);
  }
  .contact-link {
    transition: color 0.2s ease;
  }
  .contact-link:hover {
    color: var(--w-accent);
  }

  
  .contact-social-link {
    width: 2.5rem;
    height: 2.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--w-border);
    background: rgba(255, 255, 255, 0.02);
    border-radius: 0;
    color: var(--w-muted);
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }
  .contact-social-link:hover {
    color: var(--w-accent);
    border-color: var(--w-accent);
    background: rgba(30, 155, 255, 0.08);
  }
  .contact-social-link:focus-visible {
    outline: 2px solid var(--w-accent);
    outline-offset: 2px;
  }

  /* Tema terang */
  :global([data-theme='light']) #contact {
    --w-bg: #ffffff;
    --w-border: #e4e4e7;
    --w-text: #18181b;
    --w-body: #52525b;
    --w-muted: #71717a;
  }
  :global([data-theme='light']) .text-white {
    color: black;
  }
  :global([data-theme='light']) #contact textarea,
  :global([data-theme='light']) #contact input {
    background: white !important;
  }

  /* Tombol kirim (untuk form saat diaktifkan kembali) */
  #contact button.btn-primary .send-icon {
    transition:
      transform 250ms cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 200ms ease;
    will-change: transform;
    transform: translateX(3rem) translateY(1.25rem) scale(2);
    opacity: 1;
  }
  #contact button.btn-primary:hover .send-icon {
    transform: translateX(8rem) translateY(-3rem) scale(1);
    opacity: 0;
    transition-duration: 100ms;
  }
  #contact button.btn-primary:active .send-icon {
    transform: translateX(8rem) translateY(-3rem) scale(1);
    opacity: 0;
    transition-duration: 100ms;
  }
  #contact .contact-card button.btn-primary {
    padding: 0.175rem 2rem 1.25rem;
  }

  @media (min-width: 368px) and (max-width: 1023px) {
    #contact button.btn-primary .send-icon {
      transform: translateX(1rem) translateY(1.25rem) scale(2);
    }
  }

  @media (max-width: 367px) {
    #contact button.btn-primary .send-icon {
      transform: translateX(-1.25rem) translateY(1.25rem) scale(2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-card,
    .contact-social-link,
    .contact-link {
      transition: none;
    }
  }
</style>